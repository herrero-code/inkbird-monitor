# Copy this to .env and fill in your real values.
# Get TUYA_DEVICE_ID and TUYA_LOCAL_KEY by running `python -m tinytuya wizard`
# (see README for full setup).

TUYA_DEVICE_ID=your_device_id_here
TUYA_LOCAL_KEY=your_local_key_here
TUYA_DEVICE_IP=192.168.1.100
TUYA_VERSION=3.3
POLL_INTERVAL_SECONDS=3
